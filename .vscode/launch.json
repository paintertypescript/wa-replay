{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "wa-replay: full stack (Edge)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--hostname", "127.0.0.1", "--port", "3001"],
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "cascadeTerminateToConfigurations": ["wa-replay: browser (running server)"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "action": "startDebugging",
        "name": "wa-replay: browser (running server)"
      }
    },
    {
      "name": "wa-replay: server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --inspect",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "wa-replay: browser (running server)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:3001",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "wa-replay: reset debug browser profile",
      "userDataDir": "${workspaceFolder}/.vscode/.edge-debug-profile",
      "runtimeArgs": ["--remote-debugging-port=0", "--new-window", "--no-first-run", "--no-default-browser-check"],
      "cleanUp": "wholeBrowser",
      "timeout": 30000,
      "windows": {
        "runtimeExecutable": "${env:ProgramFiles(x86)}/Microsoft/Edge/Application/msedge.exe"
      }
    }
  ]
}
